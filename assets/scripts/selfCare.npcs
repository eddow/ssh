goEat = function()
	if carriedAmount > 0 and goods[carriedType].feedingValue == 0 then inventory.dropAll()
	while hunger > triggerLevels.hunger.satisfied
		if carriedAmount > 0 and carriedType and goods[carriedType].feedingValue > 0 then
			selfCare.eat()
			continue
		end if
		found = find.food()
		if not found then return false
		walk.into found.tile
		inventory.grab found.good, 1
	end while
end function

return { goEat }


