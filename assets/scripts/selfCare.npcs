function goEat()
	while hunger > triggerLevels.hunger.satisfied
		food = carriedFood
		if food then
			selfCare.eat food
			continue
		end if
		inventory.makeRoom
		found = find.food()	// TODO: goGrab
		if not found then return false
		inventory.goGrab found.good, 1, found.tile, found.path
	end while
end function

function wander()
	destination = find.wanderingTile()
	if not destination.path then return false
	walk.into destination.path
	selfCare.pondering
end function

return { goEat, wander }


