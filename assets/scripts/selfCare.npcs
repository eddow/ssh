function goEat()
	while hunger > triggerLevels.hunger.satisfied
		food = carriedFood
		if food then
			selfCare.eat food
			continue
		end if
		inventory.makeRoom
		found = find.food()
		if not found then return false
		walk.into found.path
		inventory.grab found.good, 1
	end while
end function

function wander()
	destination = find.wanderingTile()
	if not destination.path then return false
	walk.into destination.path
	selfCare.pondering
end function

return { goEat, wander }


