function until(path)
	for step in path
		if tile.position != step then
			midPoint = lerp(tile.position, step, 1/2)
			walk.moveTo midPoint
			walk.stepOn tileAt(step)
		end if
	end for
end function

function into(path)
	target = path[path.length-1]
	walk.until path
	if tile == tileAt(target) then
		walk.moveTo target
	end if
end function

return { into, until }
