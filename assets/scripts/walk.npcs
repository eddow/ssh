walk = function(target, punctual)
	if target isa tile then
		targetTile = target
		targetPosition = target.position
	else if target isa position then
		targetTile = tileAt(target)
		targetPosition = target
	else
		error "Expected: tile or position, got " + target
	end if
	while tile != targetTile
		if punctual and not canWalkIn(targetTile) then return false
		path = findPath(targetTile, punctual)
		if not path then return false
		for step in path
			if tile.position != step then
				midPoint = lerp(tile.position, step, 1/2)
				moveTo midPoint
				if not canWalkIn(tile) then break
				tile = tileAt(step)
			end if
		end for
	end while
end function

into = function(target)
	walk target, true
	moveTo target
end function

return { into: into }
