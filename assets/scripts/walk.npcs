walkTo = function(target, punctual)
	if target isa tile then
		targetTile = target
		targetPosition = target.position
	else if target isa position then
		targetTile = tileAt(target)
		targetPosition = target
	else
		error "Expected: tile or position, got " + target, target
	end if
	while tile != targetTile
		if punctual and not walk.can(targetTile) then return false
		path = find.path(targetTile, punctual)
		if not path then return false
		for step in path
			if tile.position != step then
				midPoint = lerp(tile.position, step, 1/2)
				walk.moveTo midPoint
				if not walk.can(tile) then break
				tile = tileAt(step)
			end if
		end for
	end while
end function

into = function(target)
	walkTo target, true
	walk.moveTo target
end function

return { into }
