into = function(target)
	if target isa tile then
		targetTile = target
		targetPosition = target.position
	else if target isa position then
		targetTile = tileAt(target)
		targetPosition = target
	else
		error "Expected: tile or position, got " + target
	end if
	while tile != targetTile
		for step in findPath(targetTile)
			if tile.position != step then
				midPoint = lerp(tile.position, step, 1/2)
				moveTo midPoint
				if not canWalkIn(tile) then break
				tile = tileAt(step)
			end if
		end for
	end while
	moveTo targetPosition
end function

return { into: into }
