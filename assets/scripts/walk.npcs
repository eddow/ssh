function walkTo(path)
	for step in path
		if tile.position != step then
			midPoint = lerp(tile.position, step, 1/2)
			walk.moveTo midPoint
			walk.stepOn tileAt(step)
		end if
	end for
	return true
end function

function into(path)
	target = path[path.length-1]
	if walkTo(path) and tile == tileAt(target) then
		walk.moveTo target
	end if
end function

function until(path)
	walkTo(path)
end function

return { into, until }
