walkTo = function(path)
	for step in path
		if tile.position != step then
			midPoint = lerp(tile.position, step, 1/2)
			walk.moveTo midPoint
			if not walk.stepOn(tileAt(step)) then return false
		end if
	end for
	return true
end function

into = function(path)
	target = path[path.length-1]
	if walkTo(path) and tile == tileAt(target) then
		walk.moveTo target
	end if
end function

until = function(path)
	walkTo(path)
end function

return { into, until }
