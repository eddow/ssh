goWork = function(module, job, path)
	inventory.dropAll
	while tile != module.tile
		walk.until path
		if tile != module.tile then
			path = find.path(module.tile, false)
			if not path then return false
		end if
	end while
	walk.enter
	work.prepare
	work[job] module
end function

harvest = function(module)
	while not tile.content.deposit or tile.content.deposit.name != "deposit." + module.action.deposit
		where = find.deposit(module.action.deposit)
		if not where then return false
		log "deposit at ", where.length
		walk.until where
	end while
	walk.enter
	work.harvestStep
	inventory.dropAll
end function

return { goWork, harvest }