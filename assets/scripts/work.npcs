function goWork(alveolus, job, path)
	inventory.dropAll
	if tile != alveolus.tile then do
		walk.until path
	while tile != alveolus.tile
		path = find.path(alveolus.tile, false)
		if not path then error "No path found to alveolus"
	loop
	walk.enter
	work.prepare
	work[job] alveolus
end function

function harvest(alveolus)
	do while I.keepWorking
		do while not tile.content.deposit or tile.content.deposit.name != alveolus.action.deposit
			where = find.deposit(alveolus.action.deposit)
			if not where then return false
			walk.until where
		loop
		walk.enter
		work.harvestStep
		if alveolus.gather then
			drop = inventory.planDrop(aCarriedGood, 1, alveolus.tile)
			do while tile != alveolus.tile
				path = find.path(alveolus.tile, false)
				walk.until path
			loop
			walk.enter
			// try load in the hive grid
			inventory.effectuate drop
			do
				good = aCarriedGood
			while aCarriedGood
				inventory.drop good
			loop
			pokeAlveolus	// We just did add resources in the hive, tell this alveolus to perhaps signal it
			work.convey
		else
			inventory.dropAll
		end if
	loop
end function

function transform(alveolus)
	do while I.keepWorking
		work.transformStep
	loop
end function

return { goWork, harvest, transform }