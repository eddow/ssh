function goWork(jobPlan, path)
	alveolus = jobPlan.alveolus
	plan jobPlan
		inventory.dropAllFree
		if tile != alveolus.tile then do
			walk.until path
		while tile != alveolus.tile
			path = find.path(alveolus.tile, false)
			if not path then error "No path found to alveolus"
		loop
		walk.enter
		work.prepare
		// TODO: understand why `work[job](alveolus)` doesn't work/yield
		work[jobPlan.jobType] jobPlan
	end plan
end function

function harvest(jobPlan)
	alveolus = jobPlan.alveolus
	do while I.keepWorking and alveolus.keepWorking
		do while not tile.content.deposit or tile.content.deposit.name != alveolus.action.deposit
			where = find.deposit(alveolus.action.deposit)
			if not where then return false
			walk.until where
		loop
		walk.enter
		work.harvestStep
		if isGatherable(alveolus) then
			inventory.dropAllFree
		else
			inventory.dropStored I.vehicle.stock, alveolus.tile
		end if
	loop
end function

function transform(jobPlan)
	alveolus = jobPlan.alveolus
	do while I.keepWorking and alveolus.keepWorking
		work.transformStep
	loop
end function

function convey(jobPlan)
	alveolus = jobPlan.alveolus
	do while I.keepWorking and alveolus.goodMovements.length
		work.conveyStep
		if not alveolus.goodMovements.length and alveolus.incomingGoods then
			debugger alveolus
			work.waitForIncomingGoods
		end if
	loop
end function

function gather(jobPlan)
	alveolus = jobPlan.alveolus
	do while I.keepWorking and alveolus.keepWorking
		do
			gatherable = find.gatherables(alveolus, alveolus.action.radius)
		while gatherable
			good = gatherable.goodType
			path = gatherable.path
			inventory.grabFree good, path[path.length - 1], path
		loop
		// bring back to alveolus tile (hive edge)
		path = find.path(alveolus.tile, false)
		if not path then error "No path found to alveolus"
		inventory.dropStored I.vehicle.stock, alveolus.tile, path, false
	loop
end function

return { goWork, harvest, transform, convey, gather }