function goWork(alveolus, job, path)
	inventory.dropAll
	if tile != alveolus.tile then do
		walk.until path
	while tile != alveolus.tile
		path = find.path(alveolus.tile, false)
		if not path then error "No path found to alveolus"
	loop
	walk.enter
	work.prepare
	// TODO: work = plan
	work[job](alveolus)
end function

function harvest(alveolus)
	do while I.keepWorking and alveolus.keepWorking
		do while not tile.content.deposit or tile.content.deposit.name != alveolus.action.deposit
			where = find.deposit(alveolus.action.deposit)
			if not where then return false
			walk.until where
		loop
		walk.enter
		work.harvestStep
		if alveolus.gather then
			drop = inventory.planDrop(aCarriedGood, 1, alveolus.tile)
			plan drop
				do while tile != alveolus.tile
					path = find.path(alveolus.tile, false)
					walk.until path
				loop
				walk.enter
				// try load in the hive grid
				inventory.effectuate drop
			end plan
			do
				good = aCarriedGood
			while good
				inventory.dropAsFreeGood good
			loop
			pokeAlveolus	// We just did add resources in the hive, tell this alveolus to perhaps signal it
		else
			inventory.dropAll
		end if
	loop
end function

function transform(alveolus)
	do while I.keepWorking and alveolus.keepWorking
		work.transformStep
	loop
end function

function convey(alveolus)
	do while I.keepWorking and alveolus.goodMovements.length
		work.conveyStep
		//if alveolus.incomingGoods then waitForIncomingGoods
	loop
end function

function gather(alveolus)
	do while I.keepWorking and alveolus.keepWorking
		// naive: find best free good the hive needs and bring it home
		need = find.hiveNeed()
		if not need then return false
		found = find.good(need.type)
		if not found then return false
		inventory.makeRoom
		inventory.grabFree need.type, found.tile, found.path, false
		// bring back to alveolus tile (hive edge)
		path = find.path(alveolus.tile, false)
		if not path then return false
		inventory.dropStored need.type, need.qty, alveolus.tile, path, false
		pokeAlveolus
	loop
end function

return { goWork, harvest, transform, convey, gather }