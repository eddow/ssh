function goWork(module, job, path)
	inventory.dropAll
	if tile != module.tile then do
		walk.until path
	while tile != module.tile
		path = find.path(module.tile, false)
	loop
	walk.enter
	work.prepare
	jobType[job] module
end function

function harvest(module)
	do while not tile.content.deposit or tile.content.deposit.name != module.action.deposit
		where = find.deposit(module.action.deposit)
		if not where then return false
		walk.until where
	loop
	walk.enter
	work.harvestStep
	if module.gather then
		do while tile != module.tile
			path = find.path(tile, module.tile, false)
			walk.until path
		loop
		walk.enter
		// try load in the complex grid

		do
			good = aCarriedGood
		while aCarriedGood
			inventory.drop(good, 1)
		loop
	else
		inventory.dropAll
	end if
	
end function
jobType = { harvest }
return { goWork }